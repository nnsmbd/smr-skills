# Static-site Caddy config for deployment.runtime: vps_static.
# Alternative to vps-nginx-static.conf.template — Caddy provisions and renews TLS automatically.
# Serves $DEPLOY_APP_DIR/current (the atomic release symlink). Adapt every __PLACEHOLDER__.

__APP_DOMAIN__ {
	root * __APP_ROOT__
	file_server

	# Security headers. Adjust CSP to the project's real third-party origins
	# (analytics provider, pixel, fonts, embeds) before shipping — this is a starting skeleton, not a final policy.
	header {
		# Add includeSubDomains and preload only after every subdomain serves HTTPS; preload is hard to undo.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
	}

	encode gzip

	# Deny dotfiles (e.g. .env, .git) anywhere under the web root.
	@dotfiles path_regexp \/\.
	respond @dotfiles 404

	# Hashed, content-addressed assets: safe to cache forever.
	@hashed path_regexp \.[0-9a-fA-F]{6,}\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTML and the version marker must always be revalidated.
	@revalidate path *.html /version.txt
	header @revalidate Cache-Control "no-cache"

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
