#!/usr/bin/env bash
# Static-site deploy: build once, ship a versioned release, switch a symlink atomically.
# Requires deployment.runtime: vps_static. Read references/deployment.md before adapting.
set -euo pipefail

: "${DEPLOY_HOST:?Set DEPLOY_HOST in an ignored local env file}"
: "${DEPLOY_USER:?Set DEPLOY_USER in an ignored local env file}"
: "${DEPLOY_SSH_KEY_PATH:?Set DEPLOY_SSH_KEY_PATH in an ignored local env file}"
: "${DEPLOY_APP_DIR:?Set DEPLOY_APP_DIR in an ignored local env file}"
: "${DEPLOY_HEALTHCHECK_URL:?Set DEPLOY_HEALTHCHECK_URL in an ignored local env file}"
# Where the served build SHA is read; override when the health check URL has its own path.
DEPLOY_VERSION_URL="${DEPLOY_VERSION_URL:-${DEPLOY_HEALTHCHECK_URL%/}/version.txt}"
DEPLOY_RELEASES_TO_KEEP="${DEPLOY_RELEASES_TO_KEEP:-5}"

# Replace these after the architecture gate. BUILD_OUTPUT_DIR is the static build's output folder.
INSTALL_COMMAND="__INSTALL_COMMAND__"
BUILD_COMMAND="__BUILD_COMMAND__"
BUILD_OUTPUT_DIR="__BUILD_OUTPUT_DIR__"

case "$INSTALL_COMMAND $BUILD_COMMAND $BUILD_OUTPUT_DIR" in
  *"__"*)
    echo "Replace all command/path placeholders before using this template." >&2
    exit 2
    ;;
esac

# BEGIN release-guard
# Prints ok, unknown, or diverged for the deployed revision versus the release commit.
release_guard_decision() {
  local deployed_rev="$1" release_sha="$2" repo="$3"
  if [[ -z "$deployed_rev" || "$deployed_rev" == "$release_sha" ]]; then
    echo ok
  elif ! git -C "$repo" cat-file -e "${deployed_rev}^{commit}" 2>/dev/null; then
    echo unknown
  elif git -C "$repo" merge-base --is-ancestor "$deployed_rev" "$release_sha"; then
    echo ok
  else
    echo diverged
  fi
}
# END release-guard

repo_root=$(git rev-parse --show-toplevel)
sha=$(git -C "$repo_root" rev-parse HEAD)

ssh_args=(-i "$DEPLOY_SSH_KEY_PATH" -o BatchMode=yes)
remote="$DEPLOY_USER@$DEPLOY_HOST"

# Ship only a committed state.
if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
  if [[ "${DEPLOY_ALLOW_DIRTY:-0}" != "1" ]]; then
    echo "Working tree has uncommitted changes. Commit them or set DEPLOY_ALLOW_DIRTY=1 deliberately." >&2
    exit 1
  fi
  echo "WARNING: deploying with uncommitted changes (DEPLOY_ALLOW_DIRTY=1)." >&2
fi

# Never replace production with a branch that does not contain what production runs now.
deployed_rev=$(ssh "${ssh_args[@]}" "$remote" "cat '$DEPLOY_APP_DIR/current/version.txt' 2>/dev/null || true")
deployed_rev="${deployed_rev//[[:space:]]/}"
case "$(release_guard_decision "$deployed_rev" "$sha" "$repo_root")" in
  ok) ;;
  unknown|diverged)
    if [[ "${DEPLOY_ALLOW_NON_DESCENDANT:-0}" != "1" ]]; then
      echo "Production runs ${deployed_rev}, which is unknown locally or not an ancestor of ${sha}." >&2
      echo "Fetch and merge the production revision first, or set DEPLOY_ALLOW_NON_DESCENDANT=1 after confirming the rollback of those changes is intended." >&2
      exit 1
    fi
    echo "WARNING: deploying ${sha} over non-ancestor production revision ${deployed_rev} (DEPLOY_ALLOW_NON_DESCENDANT=1)." >&2
    ;;
esac
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
release_name="${timestamp}-${sha:0:12}"

# Build locally or in CI. Never build on the server.
( cd "$repo_root" && eval "$INSTALL_COMMAND" && eval "$BUILD_COMMAND" )

build_dir="$repo_root/$BUILD_OUTPUT_DIR"
if [[ ! -d "$build_dir" ]]; then
  echo "Build output directory not found: $build_dir" >&2
  exit 1
fi

# Stamp the artifact with the deployed SHA so the health check can verify it.
echo "$sha" > "$build_dir/version.txt"

release_dir="$DEPLOY_APP_DIR/releases/$release_name"

ssh "${ssh_args[@]}" "$remote" "mkdir -p '$release_dir'"

rsync -az --delete \
  -e "ssh -i $DEPLOY_SSH_KEY_PATH -o BatchMode=yes" \
  "$build_dir/" "$remote:$release_dir/"

# Atomic symlink swap: build the new symlink next to the old one, then rename over it.
ssh "${ssh_args[@]}" "$remote" \
  "ln -sfn '$release_dir' '$DEPLOY_APP_DIR/current.new' && mv -T '$DEPLOY_APP_DIR/current.new' '$DEPLOY_APP_DIR/current'"

curl --fail --silent --show-error --retry 8 --retry-delay 2 "$DEPLOY_HEALTHCHECK_URL" >/dev/null

deployed_sha=$(curl --fail --silent --show-error "$DEPLOY_VERSION_URL")
if [[ "${deployed_sha//$'\n'/}" != "$sha" ]]; then
  echo "Health check served SHA ${deployed_sha} but expected ${sha}. Investigate before trusting this release." >&2
  exit 1
fi

# Prune old releases, keeping the most recent DEPLOY_RELEASES_TO_KEEP.
ssh "${ssh_args[@]}" "$remote" \
  "cd '$DEPLOY_APP_DIR/releases' && ls -1t | tail -n +$((DEPLOY_RELEASES_TO_KEEP + 1)) | xargs -r rm -rf --"

echo "Deployed release: $release_name (verified SHA $sha)"
