# Copy only the variables selected by the project architecture.
# Keep real values in an ignored local file or a secret manager.

PUBLIC_SITE_URL=
FORM_DELIVERY_URL=
FORM_DELIVERY_SECRET=

# CTA adapter destinations. Store the destination itself here (private URL), never in project.yaml
# or committed docs — those record only the variable name, per brief.primary_action.destination_env.
PRIMARY_ACTION_URL=
SECONDARY_ACTION_URL=
BOT_DEEPLINK_URL=
WAITLIST_ENDPOINT_URL=

# Analytics. See references/measurement.md for provider selection and consent rules.
ANALYTICS_ID=
ANALYTICS_PROVIDER_ID=
META_PIXEL_ID=
# Server-side only: requires deployment.runtime: vps_node (Conversions API needs a server call).
META_CAPI_TOKEN=

# Used only when VPS deployment is selected.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY_PATH=
DEPLOY_APP_DIR=
DEPLOY_SERVICE_NAME=
DEPLOY_HEALTHCHECK_URL=
# Optional; defaults to DEPLOY_HEALTHCHECK_URL + /version.txt.
DEPLOY_VERSION_URL=
# vps_static or vps_node; keep in sync with deployment.runtime in project.yaml.
DEPLOY_RUNTIME=
# Static path only: how many past releases to keep under releases/ before pruning.
DEPLOY_RELEASES_TO_KEEP=
